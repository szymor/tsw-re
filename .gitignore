# Original game files (the converted ones are committed under data/)
assets/
*.oz
*.bmp
*.gif
*.mid
*.dat
*.ppm
*.png

# Generated analysis artifacts
/tmp/
*.bin
append_sites.txt
timelines.txt
game_text.txt

