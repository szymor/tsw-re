# Writes OUT (a header) with TSW_COMMIT, the short hash of the source
# tree's HEAD, for Help > About.  Run on every build by CMakeLists.txt;
# the file is only rewritten when the hash changes, so nothing rebuilds
# needlessly.  Outside a git checkout (or without git) the hash is
# COMMIT if given (-DCOMMIT=... from the TSW_COMMIT cache entry), else
# "unknown".
if(NOT OUT OR NOT SRC)
    message(FATAL_ERROR "commit_header.cmake: OUT and SRC are required")
endif()
set(hash "")
if(COMMIT)
    set(hash "${COMMIT}")
else()
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
            WORKING_DIRECTORY "${SRC}"
            OUTPUT_VARIABLE hash
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
            RESULT_VARIABLE rc)
        if(NOT rc EQUAL 0)
            set(hash "")
        endif()
    endif()
endif()
if(NOT hash MATCHES "^[0-9A-Za-z._+-]+$")
    set(hash "unknown")
endif()
set(text "/* Generated by tools/commit_header.cmake: do not edit. */\n#define TSW_COMMIT \"${hash}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
